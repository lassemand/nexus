#!/usr/bin/env bash
# Run `conductor` inside the cluster from a laptop terminal.
#
#   scripts/conductor sessions list
#   scripts/conductor sessions attach irr              # join the live terminal
#   scripts/conductor sessions attach irr --read-only  # watch without typing
#   scripts/conductor sessions list --json | jq '.[].key'
#
# `conductor sessions` talks to the registry in Postgres, so it has to run in
# the pod: that is where DATABASE_URL, the worktrees and the tmux sessions
# are. There is no network API by design — control is local to the pod.
#
# `attach` hands the terminal to tmux, so it needs the TTY branch below. The
# pod's tmux prefix is Ctrl-a (detach with Ctrl-a d); inside a local tmux that
# also uses Ctrl-a, press it twice.
set -euo pipefail

CONTEXT="${CONDUCTOR_KUBE_CONTEXT:-orbstack}"
NAMESPACE="${CONDUCTOR_NAMESPACE:-conductor}"
DEPLOYMENT="${CONDUCTOR_DEPLOYMENT:-deploy/conductor}"

# -t allocates a TTY, which kubectl would otherwise use to mangle the stream
# with CRLFs and progress output. Only ask for one when stdout is really a
# terminal, so `list --json | jq` and `>file` both stay clean.
#
# Two explicit branches rather than an array of flags: expanding an *empty*
# array under `set -u` is an error in bash 3.2, which is what macOS ships as
# /bin/bash — so the array form failed on exactly the machine this script
# exists for, with "tty_flag[@]: unbound variable".
if [[ -t 1 ]]; then
    exec kubectl --context "$CONTEXT" -n "$NAMESPACE" \
        exec -i -t "$DEPLOYMENT" -c conductor -- conductor "$@"
else
    exec kubectl --context "$CONTEXT" -n "$NAMESPACE" \
        exec -i "$DEPLOYMENT" -c conductor -- conductor "$@"
fi
