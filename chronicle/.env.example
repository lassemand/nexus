# Copy this to chronicle/.env and fill in real values — .env itself is
# gitignored, never commit real credentials.
#
# Loaded automatically by saxo_stream via dotenvy at startup
# (chronicle/src/saxo_stream.rs's main()).

# ── Postgres ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://nexus:nexus@localhost:5432/chronicle

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:32092
KAFKA_TOPIC=market.bars

# ── Saxo hosts ────────────────────────────────────────────────────────────
# These three MUST all point at the same environment together — mixing a
# live host with a SIM host (or vice versa) will fail auth or resolve the
# wrong instruments. Defaults below are SIM; for live, use:
#   SAXO_API_BASE=https://gateway.saxobank.com/openapi
#   SAXO_STREAMING_BASE=https://live-streaming.saxobank.com/oapi/streaming/ws
#   SAXO_AUTH_BASE=https://live.logonvalidation.net
SAXO_API_BASE=https://gateway.saxobank.com/sim/openapi
SAXO_STREAMING_BASE=https://sim-streaming.saxobank.com/sim/oapi/streaming/ws
SAXO_AUTH_BASE=https://sim.logonvalidation.net

# ── Saxo OAuth2 app registration ─────────────────────────────────────────
# From developer.saxo — SIM and live are SEPARATE app registrations with
# different AppKey/AppSecret pairs. A live client_id will not authenticate
# against SAXO_AUTH_BASE=sim.logonvalidation.net (or vice versa).
# See docs/guides/saxo-oauth-setup.md for the full registration walkthrough.
SAXO_CLIENT_ID=REPLACE_WITH_SIM_APP_KEY
SAXO_CLIENT_SECRET=REPLACE_WITH_SIM_APP_SECRET

# Bootstrap-only: used solely if the oauth_tokens table has no row yet.
# Obtained by completing the interactive OAuth authorize flow in a browser
# against ${SAXO_AUTH_BASE}/authorize with the client_id above — this cannot
# be done via curl/script, it requires an actual login. See
# docs/guides/saxo-oauth-setup.md for the full walkthrough. Once the service
# has rotated at least once, the DB value takes precedence over these two
# on every subsequent restart.
SAXO_REFRESH_TOKEN=REPLACE_WITH_BOOTSTRAP_REFRESH_TOKEN
SAXO_ACCESS_TOKEN=REPLACE_WITH_BOOTSTRAP_ACCESS_TOKEN

# Unix timestamp for the initial access token's expiry. Set to a
# near-future value to force a rotation within seconds for local testing,
# e.g.: SAXO_TOKEN_EXPIRES_AT=$(date +%s -d '+10 seconds')
SAXO_TOKEN_EXPIRES_AT=REPLACE_WITH_UNIX_TIMESTAMP

# ── Optional (defaults shown) ─────────────────────────────────────────────
TICKER_REFRESH_INTERVAL_SECS=300
HEALTH_PORT=8080
BAR_WINDOW_SECS=60
