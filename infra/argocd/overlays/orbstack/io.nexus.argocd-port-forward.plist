<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent — optional port-forward for ArgoCD on OrbStack.

  On OrbStack, argocd-server is a LoadBalancer service with a direct IP,
  so the UI is accessible at https://<lb-ip> without any port-forward.
  This plist is kept for convenience if you prefer https://localhost:8080.

  Installed and loaded by Terraform (infra/terraform/orbstack/), which runs on the
  host. From a checkout on the Mac mini:

    cd infra/terraform && make apply LAYER=orbstack

  Terraform copies this file to ~/Library/LaunchAgents/ and reloads the agent only
  when the file changes. Do not `cp` or `launchctl load` it by hand: the manual
  steps are deprecated and would fight Terraform over the same file.

  Uninstall: remove launchagent-argocd-port-forward.tf and apply; Terraform boots
  the agent out and deletes the installed copy.

  Logs:
    tail -f /tmp/argocd-port-forward.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.nexus.argocd-port-forward</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/kubectl</string>
    <string>--context</string>
    <string>orbstack</string>
    <string>port-forward</string>
    <string>svc/argocd-server</string>
    <string>8080:443</string>
    <string>-n</string>
    <string>argocd</string>
  </array>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/argocd-port-forward.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/argocd-port-forward.log</string>
</dict>
</plist>
